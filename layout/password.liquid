<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_champagne_cream | default: '#EFE7DF' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'lunelle-brand-mark-taupe.svg' | asset_url }}">
    {%- endif -%}

    <title>{{ shop.name }} &ndash; Opening Soon</title>

    <style>
      :root {
        --color-champagne-cream: {{ settings.color_champagne_cream | default: '#EFE7DF' }};
        --color-soft-nude-beige: {{ settings.color_soft_nude_beige | default: '#D8C7B8' }};
        --color-dusty-rose-taupe: {{ settings.color_dusty_rose_taupe | default: '#B9968A' }};
        --color-warm-mocha-brown: {{ settings.color_warm_mocha-brown | default: '#8A6B5A' }};
        --color-cocoa-taupe: {{ settings.color_cocoa_taupe | default: '#6B5448' }};
        --color-white: {{ settings.color_white | default: '#FFFFFF' }};
      }
    </style>

    <link rel="preload" href="{{ 'cochin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'cochin-bold.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template-password gradient" style="background-color: var(--color-champagne-cream);">
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
