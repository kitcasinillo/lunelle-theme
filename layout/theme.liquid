<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_champagne_cream | default: '#EFE7DF' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'lunelle-brand-mark-taupe.svg' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'social-meta-tags' %}

    <style>
      :root {
        --color-champagne-cream: {{ settings.color_champagne_cream | default: '#EFE7DF' }};
        --color-soft-nude-beige: {{ settings.color_soft_nude_beige | default: '#D8C7B8' }};
        --color-dusty-rose-taupe: {{ settings.color_dusty_rose_taupe | default: '#B9968A' }};
        --color-warm-mocha-brown: {{ settings.color_warm_mocha-brown | default: '#8A6B5A' }};
        --color-cocoa-taupe: {{ settings.color_cocoa_taupe | default: '#6B5448' }};
        --color-white: {{ settings.color_white | default: '#FFFFFF' }};
      }
    </style>

    <link rel="preload" href="{{ 'cochin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'cochin-bold.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }} gradient">
    <a class="skip-to-content-link visually-hidden" href="#MainContent" style="position: absolute; left: -9999px; top: 0;">
      {{ 'general.accessibility.skip_to_text' | t }}
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
