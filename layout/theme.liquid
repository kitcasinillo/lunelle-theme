<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_champagne_cream | default: '#EFE7DF' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'lunelle-brand-mark-taupe.svg' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- capture meta_description -%}
      {%- if page_description -%}
        {{ page_description | escape }}
      {%- elsif template.name == 'index' -%}
        {{ shop.description | default: 'Lunelle &ndash; Luxury Mulberry Silk Intimates and Wire-Free Loungewear designed for self-reclamation, motherhood rituals, and quiet confidence.' | escape }}
      {%- elsif template.name == 'collection' -%}
        {{ collection.description | strip_html | truncatewords: 30 | default: 'Explore curated wire-free silk bralettes, slips, and luxury loungewear crafted with pure intention by Lunelle.' | escape }}
      {%- elsif template.name == 'product' -%}
        {{ product.description | strip_html | truncatewords: 30 | escape }}
      {%- else -%}
        {{ shop.description | default: 'To remind women that they, too, deserve beauty, softness, and care. Handcrafted luxury silk intimates by Lunelle.' | escape }}
      {%- endif -%}
    {%- endcapture -%}
    <meta name="description" content="{{ meta_description | strip }}">

    {% render 'social-meta-tags' %}

    <style>
      :root {
        --color-champagne-cream: {{ settings.color_champagne_cream | default: '#EFE7DF' }};
        --color-soft-nude-beige: {{ settings.color_soft_nude_beige | default: '#D8C7B8' }};
        --color-dusty-rose-taupe: {{ settings.color_dusty_rose_taupe | default: '#B9968A' }};
        --color-warm-mocha-brown: {{ settings.color_warm_mocha_brown | default: '#8A6B5A' }};
        --color-cocoa-taupe: {{ settings.color_cocoa_taupe | default: '#6B5448' }};
        --color-white: {{ settings.color_white | default: '#FFFFFF' }};
      }
    </style>

    <link rel="preload" href="{{ 'cochin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'cochin-bold.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      window.Lunelle = window.Lunelle || {};
      window.Lunelle.routes = {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        all_products_url: '{{ routes.all_products_collection_url }}'
      };
      window.Lunelle.strings = {
        addToCart: {{ 'products.product.add_to_cart' | t | default: 'Keep for Yourself' | json }},
        soldOut: {{ 'products.product.sold_out' | t | default: 'Currently Resting' | json }},
        unavailable: {{ 'products.product.unavailable' | t | default: 'Unavailable' | json }},
        freeShippingAchieved: {{ 'sections.cart.free_shipping_achieved' | t | default: 'Complimentary domestic care delivery unlocked' | json }},
        emptyCart: {{ 'sections.cart.empty' | t | default: 'Your bag is waiting. Treat yourself to a moment of softness.' | json }}
      };
      window.Lunelle.settings = {
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 3500 }},
        moneyFormat: {{ shop.money_format | default: '₱{{amount}}' | json }}
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }} gradient">
    <a class="skip-to-content-link visually-hidden" href="#MainContent" style="position: absolute; left: -9999px; top: 0;">
      {{ 'general.accessibility.skip_to_text' | t }}
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
