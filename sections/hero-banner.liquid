<section class="hero-banner" id="hero-{{ section.id }}">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        <h1 class="hero-title">{{ section.settings.heading | escape }}</h1>

        <p class="hero-subtitle">{{ section.settings.subheading | escape }}</p>

        <div class="hero-actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-primary">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a href="{{ section.settings.secondary_button_link | default: '/pages/our-story' }}" class="btn btn-secondary">
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="hero-media-wrapper">
        <div class="hero-media-card">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="
                {{ section.settings.image | image_url: width: 600 }} 600w,
                {{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w,
                {{ section.settings.image | image_url: width: 1600 }} 1600w
              "
              sizes="(max-width: 768px) 100vw, 50vw"
              alt="{{ section.settings.heading | escape }}"
              width="1200"
              height="1500"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            <img
              src="https://images.unsplash.com/photo-1518895949257-7621c3c786d7?q=80&w=1200&auto=format&fit=crop"
              alt="Soft morning light luxury lingerie"
              width="1200"
              height="1500"
              loading="eager"
              fetchpriority="high"
            >
          {%- endif -%}
        </div>

        <div class="hero-badge-float">
          <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem;">
            {% render 'icon-lotus', width: 18, height: 18, color: '#B9968A' %}
            <span style="font-family: var(--font-heading); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-dusty-rose-taupe); font-weight: 700;">Brand Promise</span>
          </div>
          <p>"Every piece reminds you that you, too, deserve beauty."</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The Self-Care Ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Softness, Reclaimed"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Luxury lingerie for the woman who gives her best to everyone else and deserves to keep something beautiful for herself."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
