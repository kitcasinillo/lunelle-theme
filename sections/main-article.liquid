<article class="article-template" style="padding: 4rem 0 7rem;">
  <div class="container" style="max-width: 820px;">
    <!-- Breadcrumb / Back Link -->
    <div style="margin-bottom: 2rem;">
      <a href="{{ blog.url }}" class="btn-link" style="font-size: 0.85rem;">
        {{ 'sections.blog.back_to_blog' | t }}
      </a>
    </div>

    <!-- Article Header -->
    <header class="article-header" style="text-align: center; margin-bottom: 3rem;">
      <div style="display: inline-flex; justify-content: center; margin-bottom: 0.75rem;">
        {% render 'icon-lotus', width: 28, height: 28, color: '#6B5448' %}
      </div>
      <div style="font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-warm-mocha-brown); margin-bottom: 1rem;">
        <span>{{ article.published_at | time_tag: format: 'date' }}</span>
        {%- if article.author -%}
          <span> · Written with intention by {{ article.author }}</span>
        {%- endif -%}
      </div>
      <h1 class="h1" style="line-height: 1.25; margin-bottom: 1.5rem;">{{ article.title }}</h1>
    </header>

    {%- if article.image -%}
      <div class="article-featured-image" style="aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 3.5rem; background-color: var(--color-soft-nude-beige);">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          width="1200"
          height="675"
          style="width: 100%; height: 100%; object-fit: cover;"
        >
      </div>
    {%- endif -%}

    <!-- Article Body -->
    <div class="article-content" style="font-size: 1.1rem; line-height: 1.85; color: var(--color-cocoa-taupe);">
      {{ article.content }}
    </div>

    <!-- Article Footer / Share -->
    <footer class="article-footer" style="margin-top: 4rem; padding-top: 2rem; border-top: var(--border-delicate); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <a href="{{ blog.url }}" class="btn-link">
        {{ 'sections.blog.back_to_blog' | t }}
      </a>
      <div style="font-style: italic; color: var(--color-warm-mocha-brown); font-family: var(--font-heading);">
        "You remembered yourself today. This piece is yours."
      </div>
    </footer>
  </div>
</article>

{% schema %}
{
  "name": "Article Content",
  "tag": "section",
  "class": "section"
}
{% endschema %}
