{%- if section.settings.show_announcement -%}
  <div class="announcement-bar">
    <div class="container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" style="color: inherit;">
          {{ section.settings.text | escape }}
        </a>
      {%- else -%}
        <span>{{ section.settings.text | escape }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Every piece reminds you that you, too, deserve beauty. Enjoy complimentary domestic delivery over ₱3,500."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
