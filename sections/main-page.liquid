<section style="padding: 5rem 0 7rem;">
  <div class="container container-narrow">
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <div class="page-header-mark" style="margin-bottom: 1rem;">
        {% render 'icon-lotus', width: 40, height: 40, color: '#6B5448' %}
      </div>
      <h1 class="h1">{{ page.title }}</h1>
    </div>

    <div style="font-size: 1.125rem; line-height: 1.9; color: var(--color-warm-mocha-brown);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
