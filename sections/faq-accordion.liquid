<div class="faq-section" style="background-color: var(--color-bg, #FAF7F4); padding: 60px 20px;">
  <div class="container" style="max-width: 860px; margin: 0 auto;">
    
    <div class="section-header text-center" style="margin-bottom: 48px; text-align: center;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" style="display: block; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--color-accent, #8A6B5A); margin-bottom: 8px;">
          {{ section.settings.eyebrow | escape }}
        </span>
      {%- endif -%}
      <h1 class="faq-title" style="font-family: var(--font-heading-family, Cochin, Georgia, serif); font-size: 32px; color: var(--color-text, #362B28); margin: 0 0 16px 0; font-weight: 700;">
        {{ section.settings.heading | default: 'Frequently Asked Questions & Care Rituals' }}
      </h1>
      {%- if section.settings.subheading != blank -%}
        <p class="faq-subtitle" style="font-size: 15px; color: var(--color-text-secondary, #6B5448); max-width: 600px; margin: 0 auto; line-height: 1.6;">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}
    </div>

    <!-- FAQ Accordion Container -->
    <div class="faq-accordion-wrapper" style="display: flex; flex-direction: column; gap: 14px;">
      {%- for block in section.blocks -%}
        <details class="faq-item" style="background-color: #FFFFFF; border: 1px solid #EFE7DF; border-radius: 4px; overflow: hidden; transition: all 0.25s ease;" {{ block.shopify_attributes }}>
          <summary class="faq-question" style="padding: 20px 24px; font-family: var(--font-heading-family, Cochin, Georgia, serif); font-size: 16px; font-weight: 600; color: #362B28; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none;">
            <span>{{ block.settings.question | escape }}</span>
            <span class="faq-icon" style="font-size: 18px; color: #8A6B5A; transition: transform 0.25s ease; margin-left: 12px;">+</span>
          </summary>
          <div class="faq-answer" style="padding: 0 24px 22px 24px; font-size: 14px; line-height: 1.7; color: #5C4D46; border-top: 1px solid #FAF7F4;">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>

    <!-- Direct Concierge Help Box -->
    <div class="concierge-card" style="margin-top: 50px; background-color: #FAF7F4; border: 1px solid #E2D7CF; border-radius: 6px; padding: 28px 24px; text-align: center;">
      <h3 style="font-family: var(--font-heading-family, Cochin, Georgia, serif); font-size: 18px; color: #362B28; margin: 0 0 8px 0;">Need Personalized Fit Advice or Care Guidance?</h3>
      <p style="font-size: 14px; color: #6B5448; margin: 0 0 16px 0;">Our Customer Concierge is here to assist with intimate measurements, fabric care, or order inquiries.</p>
      <a href="mailto:hello@lunelle.ph" class="button" style="display: inline-block; background-color: #362B28; color: #FFFFFF; padding: 12px 26px; border-radius: 2px; text-decoration: none; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; font-weight: 600;">
        Contact Concierge
      </a>
    </div>

  </div>
</div>

<style>
  .faq-item[open] summary .faq-icon {
    transform: rotate(45deg);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item:hover {
    border-color: #D8C7B8;
  }
</style>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Care & Inquiries"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions & Care Rituals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about our wire-free intimate fit, delicate care rituals, and domestic courier shipping."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I choose my correct intimate size?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We design our wire-free bralettes and loungewear to gently adapt to your natural contours. Consult our Sizing Guide on each product page, or contact our Concierge at hello@lunelle.ph for tailored sizing recommendations.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How do Lunelle's wire-free designs provide gentle support?",
            "answer": "<p>Lunelle designs lingerie that honors a woman's natural silhouette. Instead of rigid underwires that pinch or restrict, we utilize precision anatomical cuts, supportive underband tension, and premium double-lined fabrics that provide tender, uplifted structure with zero pressure points.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the recommended Care Ritual for delicate intimate garments?",
            "answer": "<p>To preserve the delicate luster, elasticity, and softness of your pieces: hand wash gently in cool water using mild pH-neutral detergent. Avoid harsh wringing or machine spin drying. Gently press between a soft towel to remove excess moisture and line dry flat in the shade away from direct sunlight.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Where do you ship and what are the delivery timeframes?",
            "answer": "<p>We deliver nationwide across the Philippines. Metro Manila orders typically arrive within 2 to 4 business days. Provincial areas in Luzon, Visayas, and Mindanao arrive within 4 to 7 business days via our designated courier partners (EasyShip / J&T / LBC). All orders are accompanied by real-time tracking updates.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is domestic shipping complimentary?",
            "answer": "<p>Yes. All orders with a subtotal of ₱3,500.00 PHP or higher automatically qualify for complimentary domestic delivery applied directly at checkout.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the return and hygiene policy for intimate apparel?",
            "answer": "<p>Under Philippine consumer and health guidelines (RA 7394), intimate undergarments worn directly against delicate skin cannot be returned once tried on, washed, or unsealed. We provide a 7-calendar-day inspection window from delivery receipt for any verified manufacturing flaws or dispatch discrepancies. Approved returns receive 1-to-1 replacement or Store Credit valid for 12 months.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How will my order be packaged? Can I include a gift message?",
            "answer": "<p>Every Lunelle order is packaged as an intimate gift to yourself. Garments are wrapped in soft tissue paper and housed in a discreet, elegant exterior box. During checkout, you can add a whisper gift note that will be printed on our signature cardstock.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
