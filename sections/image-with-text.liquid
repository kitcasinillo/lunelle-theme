<section class="section-image-with-text" style="padding: var(--section-spacing-y) 0; background-color: {% if section.settings.bg_secondary %}var(--color-soft-nude-beige){% else %}var(--color-champagne-cream){% endif %};">
  <div class="container">
    <div class="image-text-grid image-text-grid--{{ section.settings.layout }}">
      {%- capture media_col -%}
        <div style="position: relative; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-card); aspect-ratio: 4 / 5;">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=900&auto=format&fit=crop" alt="Intimate morning portrait" style="width: 100%; height: 100%; object-fit: cover;">
          {%- endif -%}
        </div>
      {%- endcapture -%}

      {%- capture text_col -%}
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}

          <h2 class="h2" style="margin-bottom: 1.5rem;">{{ section.settings.heading | escape }}</h2>

          <div style="font-size: 1.0625rem; line-height: 1.8; color: var(--color-warm-mocha-brown); margin-bottom: 2rem;">
            {{ section.settings.text }}
          </div>

          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-primary">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endcapture -%}

      {%- if section.settings.layout == 'image_first' -%}
        {{ media_col }}
        {{ text_col }}
      {%- else -%}
        {{ text_col }}
        {{ media_col }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Alignment",
      "options": [
        {
          "value": "image_first",
          "label": "Image on Left"
        },
        {
          "value": "text_first",
          "label": "Image on Right"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "checkbox",
      "id": "bg_secondary",
      "label": "Use Soft Nude Beige Background",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Motherhood Journey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Motherhood changes everything, except the woman you are beneath it all."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>You give your best to everyone. Your hours, your devotion, your energy. In the whirlwind of nurturing, it is easy to let your own softness fade into memory.</p><p>LUNELLE was created for what remains. Designed with gentle, wire-free contours, cloud-soft silk blends, and empathetic sizing that honors the natural evolution of your body.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore the Motherhood Edit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
