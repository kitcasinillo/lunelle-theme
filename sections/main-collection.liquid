<section class="section-featured-collection" style="padding: 3.5rem 0 6rem;">
  <div class="container">
    <!-- Filter Bar -->
    <div class="collection-filter-bar">
      <div class="collection-filter-count">
        Showing {{ collection.products_count | default: 4 }} pieces
      </div>

      <div class="collection-filter-sort">
        <label for="SortBy">Sort by:</label>
        <select id="SortBy" class="collection-sort-select">
          <option value="featured">Curated Rituals</option>
          <option value="best-selling">Most Beloved</option>
          <option value="price-ascending">Price: Low to High</option>
          <option value="price-descending">Price: High to Low</option>
          <option value="created-descending">New Arrivals</option>
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="product-grid">
      {%- paginate collection.products by 12 -%}
        {%- for product in collection.products -%}
          {% render 'card-product', card_product: product, show_secondary_image: true %}
        {%- else -%}
          <div class="product-card">
            <div class="product-card-image-box">
              <span class="product-badge">Bestseller</span>
              <img src="https://images.unsplash.com/photo-1596704017254-9b121068fb31?q=80&w=700&auto=format&fit=crop" alt="The Dawn Silk Bralette" class="img-primary">
              <button type="button" class="quick-add-btn" data-quick-add>
                {% render 'icon-cart' %}
                <span>Keep for Yourself</span>
              </button>
            </div>
            <div class="product-card-info">
              <h3 class="product-card-title"><a href="#">The Dawn Silk Bralette</a></h3>
              <div class="product-card-tones">Champagne Cream · Soft Nude</div>
              <div class="product-card-price">₱3,250.00</div>
            </div>
          </div>

          <div class="product-card">
            <div class="product-card-image-box">
              <span class="product-badge">Self-Care Ritual</span>
              <img src="https://images.unsplash.com/photo-1583209814683-c023dd293cc6?q=80&w=700&auto=format&fit=crop" alt="Solitary Bloom Lace Bodysuit" class="img-primary">
              <button type="button" class="quick-add-btn" data-quick-add>
                {% render 'icon-cart' %}
                <span>Keep for Yourself</span>
              </button>
            </div>
            <div class="product-card-info">
              <h3 class="product-card-title"><a href="#">Solitary Bloom Lace Bodysuit</a></h3>
              <div class="product-card-tones">Dusty Rose Taupe · Cocoa</div>
              <div class="product-card-price">₱4,650.00</div>
            </div>
          </div>

          <div class="product-card">
            <div class="product-card-image-box">
              <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=700&auto=format&fit=crop" alt="The Sanctuary Silk Robe" class="img-primary">
              <button type="button" class="quick-add-btn" data-quick-add>
                {% render 'icon-cart' %}
                <span>Keep for Yourself</span>
              </button>
            </div>
            <div class="product-card-info">
              <h3 class="product-card-title"><a href="#">The Sanctuary Silk Robe</a></h3>
              <div class="product-card-tones">Champagne Cream</div>
              <div class="product-card-price">₱5,800.00</div>
            </div>
          </div>

          <div class="product-card">
            <div class="product-card-image-box">
              <span class="product-badge">Motherhood Edit</span>
              <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?q=80&w=700&auto=format&fit=crop" alt="Whispers Wireless Soft Bra" class="img-primary">
              <button type="button" class="quick-add-btn" data-quick-add>
                {% render 'icon-cart' %}
                <span>Keep for Yourself</span>
              </button>
            </div>
            <div class="product-card-info">
              <h3 class="product-card-title"><a href="#">Whispers Wireless Soft Bra</a></h3>
              <div class="product-card-tones">Warm Mocha · Soft Nude</div>
              <div class="product-card-price">₱2,850.00</div>
            </div>
          </div>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <div style="grid-column: 1 / -1; text-align: center; margin-top: 3rem;">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
