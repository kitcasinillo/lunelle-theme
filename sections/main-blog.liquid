<section class="section-main-blog" style="padding: 4rem 0 6rem;">
  <div class="container">
    <div class="page-header-mark" style="margin-bottom: 3.5rem; text-align: center;">
      <div style="display: inline-flex; justify-content: center; margin-bottom: 0.75rem;">
        {% render 'icon-lotus', width: 28, height: 28, color: '#6B5448' %}
      </div>
      <h1 class="h2" style="margin: 0 0 0.5rem;">{{ blog.title | default: 'sections.blog.title' | t }}</h1>
      <p style="color: var(--color-warm-mocha-brown); font-style: italic; max-width: 540px; margin: 0 auto;">
        {{ section.settings.subheading | default: 'Reflections on intentional self-care, motherhood transitions, and claiming beauty for yourself.' }}
      </p>
    </div>

    {%- paginate blog.articles by 6 -%}
      <div class="blog-articles-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 3rem 2rem;">
        {%- for article in blog.articles -%}
          <article class="blog-card" style="display: flex; flex-direction: column;">
            {%- if article.image -%}
              <a href="{{ article.url }}" style="display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 1.25rem; background-color: var(--color-soft-nude-beige);">
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="500"
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
              </a>
            {%- endif -%}

            <div class="blog-card-meta" style="font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-warm-mocha-brown); margin-bottom: 0.5rem;">
              <span>{{ article.published_at | time_tag: format: 'date' }}</span>
              {%- if article.tags.size > 0 -%}
                <span> · {{ article.tags.first }}</span>
              {%- endif -%}
            </div>

            <h2 style="font-family: var(--font-heading); font-size: 1.4rem; line-height: 1.3; margin: 0 0 0.75rem;">
              <a href="{{ article.url }}" style="color: var(--color-cocoa-taupe); text-decoration: none;">
                {{ article.title }}
              </a>
            </h2>

            <div style="font-size: 0.95rem; color: var(--color-warm-mocha-brown); line-height: 1.6; margin-bottom: 1.25rem;">
              {%- if article.excerpt.size > 0 -%}
                {{ article.excerpt | strip_html | truncatewords: 24 }}
              {%- else -%}
                {{ article.content | strip_html | truncatewords: 24 }}
              {%- endif -%}
            </div>

            <div style="margin-top: auto;">
              <a href="{{ article.url }}" class="btn-link" style="font-size: 0.85rem;">
                {{ 'sections.blog.read_more' | t }} &rarr;
              </a>
            </div>
          </article>
        {%- else -%}
          <!-- Mock Journal Articles for Preview -->
          <article class="blog-card" style="display: flex; flex-direction: column;">
            <div style="aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 1.25rem; background-color: var(--color-soft-nude-beige);">
              <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?q=80&w=800&auto=format&fit=crop" alt="The Morning Pause" width="800" height="500" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div style="font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-warm-mocha-brown); margin-bottom: 0.5rem;">
              <span>Rituals · 5 Min Read</span>
            </div>
            <h2 style="font-family: var(--font-heading); font-size: 1.4rem; line-height: 1.3; margin: 0 0 0.75rem; color: var(--color-cocoa-taupe);">
              The Morning Pause: Reclaiming 10 Minutes Just For You
            </h2>
            <p style="font-size: 0.95rem; color: var(--color-warm-mocha-brown); line-height: 1.6; margin-bottom: 1.25rem;">
              Before the demands of family and work begin, a single quiet cup of warm tea and the feel of real silk against waking skin can anchor your entire day.
            </p>
            <div style="margin-top: auto;">
              <span class="btn-link" style="font-size: 0.85rem;">Read the Journal &rarr;</span>
            </div>
          </article>

          <article class="blog-card" style="display: flex; flex-direction: column;">
            <div style="aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 1.25rem; background-color: var(--color-soft-nude-beige);">
              <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?q=80&w=800&auto=format&fit=crop" alt="Softness as Strength" width="800" height="500" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div style="font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-warm-mocha-brown); margin-bottom: 0.5rem;">
              <span>Motherhood · 4 Min Read</span>
            </div>
            <h2 style="font-family: var(--font-heading); font-size: 1.4rem; line-height: 1.3; margin: 0 0 0.75rem; color: var(--color-cocoa-taupe);">
              Why Softness is an Act of Reclamation, Not Weakness
            </h2>
            <p style="font-size: 0.95rem; color: var(--color-warm-mocha-brown); line-height: 1.6; margin-bottom: 1.25rem;">
              We are taught to endure rigidity. But choosing luxurious, wire-free comfort is a quiet declaration that your body deserves ease.
            </p>
            <div style="margin-top: auto;">
              <span class="btn-link" style="font-size: 0.85rem;">Read the Journal &rarr;</span>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div style="margin-top: 3.5rem; text-align: center;">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog Posts",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Reflections on intentional self-care, motherhood transitions, and claiming beauty for yourself."
    }
  ]
}
{% endschema %}
