<section class="section-password" style="min-height: 85vh; display: flex; align-items: center; justify-content: center; padding: 4rem 1.5rem; text-align: center;">
  <div style="max-width: 580px; width: 100%;">
    <div class="password-brand" style="margin-bottom: 2rem;">
      <div style="display: inline-flex; justify-content: center; margin-bottom: 1.25rem;">
        {% render 'icon-lotus', width: 44, height: 44, color: '#6B5448' %}
      </div>
      <h1 style="font-family: var(--font-heading); font-size: 2.25rem; color: var(--color-cocoa-taupe); margin: 0 0 0.5rem; letter-spacing: 0.08em; text-transform: uppercase;">
        {{ shop.name }}
      </h1>
      <p style="font-style: italic; color: var(--color-warm-mocha-brown); font-size: 1.1rem; line-height: 1.6; margin: 0 auto; max-width: 480px;">
        {{ section.settings.message | default: 'We are quietly preparing our next sanctuary of pieces. Something soft and tender is coming soon.' }}
      </p>
    </div>

    <!-- Password Prompt Form -->
    <div class="password-form-wrap" style="background-color: var(--color-soft-nude-beige); padding: 2.5rem 2rem; border-radius: var(--radius-sm); border: var(--border-delicate); margin-top: 2rem;">
      <h2 style="font-family: var(--font-heading); font-size: 1.2rem; color: var(--color-cocoa-taupe); margin: 0 0 1rem;">
        Enter Private Access
      </h2>

      {% form 'storefront_password', class: 'password-form' %}
        {%- if form.errors -%}
          <div style="color: #9A3B3B; font-size: 0.9rem; margin-bottom: 1rem;">
            {{ form.errors.messages['form'] }}
          </div>
        {%- endif -%}

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <input
            type="password"
            name="password"
            id="Password"
            class="input-field"
            placeholder="Private passphrase..."
            style="flex: 1; min-width: 200px; padding: 0.85rem 1rem; border: var(--border-delicate); border-radius: var(--radius-full); background: var(--color-white); font-family: var(--font-body); outline: none;"
          >
          <button type="submit" name="commit" class="btn btn-primary" style="padding: 0.85rem 1.75rem;">
            Enter Sanctuary
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Whisper Reminder -->
    <p style="margin-top: 3rem; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-warm-mocha-brown);">
      You remembered yourself today. This piece is yours.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Password Sanctuary",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Sanctuary Message",
      "default": "We are quietly preparing our next sanctuary of pieces. Something soft and tender is coming soon."
    }
  ]
}
{% endschema %}
