{% comment %}
  Lunelle Collection Schema.org JSON-LD Structured Data
  Renders CollectionPage and BreadcrumbList schemas for search indexing.
{% endcomment %}

{%- if collection != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "url": {{ request.origin | append: collection.url | json }},
    {%- if collection.description != blank -%}
      "description": {{ collection.description | strip_html | truncatewords: 50 | json }},
    {%- endif -%}
    {%- assign collection_image = collection.image | default: collection.products.first.featured_media -%}
    {%- if collection_image -%}
      "image": {{ collection_image | image_url: width: 1200 | prepend: "https:" | json }},
    {%- endif -%}
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": [
        {%- for product in collection.products limit: 20 -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "url": {{ request.origin | append: product.url | json }},
            "name": {{ product.title | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Collections",
        "item": {{ request.origin | append: routes.collections_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      }
    ]
  }
  </script>
{%- endif -%}
