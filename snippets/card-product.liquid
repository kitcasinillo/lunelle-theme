{% comment %}
  Lunelle Luxury Product Card Snippet
  Accepts:
  - card_product: {Object} Product Liquid object
  - show_secondary_image: {Boolean}
  - media_aspect_ratio: {String}
{% endcomment %}

{%- liquid
  assign featured_media = card_product.featured_media | default: card_product.images[0]
  assign secondary_media = card_product.media[1] | default: card_product.images[1]
-%}

<div class="product-card" data-product-id="{{ card_product.id }}">
  <div class="product-card-image-box">
    {%- if card_product.tags contains 'Bestseller' or card_product.tags contains 'Ritual' -%}
      <span class="product-badge">
        {%- if card_product.tags contains 'Bestseller' -%}Bestseller{%- else -%}Self-Care Ritual{%- endif -%}
      </span>
    {%- endif -%}

    <a href="{{ card_product.url }}" class="product-card-link" aria-label="{{ card_product.title | escape }}">
      {%- if featured_media -%}
        <img
          src="{{ featured_media | image_url: width: 720 }}"
          srcset="
            {{ featured_media | image_url: width: 360 }} 360w,
            {{ featured_media | image_url: width: 540 }} 540w,
            {{ featured_media | image_url: width: 720 }} 720w,
            {{ featured_media | image_url: width: 900 }} 900w
          "
          sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
          alt="{{ featured_media.alt | default: card_product.title | escape }}"
          class="img-primary"
          loading="lazy"
          width="720"
          height="960"
        >
        {%- if secondary_media and show_secondary_image != false -%}
          <img
            src="{{ secondary_media | image_url: width: 720 }}"
            srcset="
              {{ secondary_media | image_url: width: 360 }} 360w,
              {{ secondary_media | image_url: width: 540 }} 540w,
              {{ secondary_media | image_url: width: 720 }} 720w,
              {{ secondary_media | image_url: width: 900 }} 900w
            "
            sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
            alt="{{ secondary_media.alt | default: card_product.title | escape }}"
            class="img-secondary"
            loading="lazy"
            width="720"
            height="960"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    <button
      type="button"
      class="quick-add-btn"
      data-quick-add
      data-product-id="{{ card_product.id }}"
      data-variant-id="{{ card_product.selected_or_first_available_variant.id }}"
      {% unless card_product.selected_or_first_available_variant.available %}disabled{% endunless %}
      aria-label="{{ 'products.product.add_to_cart' | t }}"
    >
      {% render 'icon-cart' %}
      <span>
        {%- if card_product.selected_or_first_available_variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </button>
  </div>

  <div class="product-card-info">
    <h3 class="product-card-title">
      <a href="{{ card_product.url }}">{{ card_product.title }}</a>
    </h3>

    <div class="product-card-tones">
      {%- if card_product.options_by_name['Color'] or card_product.options_by_name['Tone'] -%}
        {%- assign tone_option = card_product.options_by_name['Color'] | default: card_product.options_by_name['Tone'] -%}
        {{ tone_option.values | join: ' · ' }}
      {%- else -%}
        Champagne · Soft Nude · Dusty Rose
      {%- endif -%}
    </div>

    <div class="product-card-price">
      {% render 'price', product: card_product, price_class: '' %}
    </div>
  </div>
</div>
