[
  {
    "name": "theme_info",
    "theme_name": "Lunelle Luxury OS 2.0",
    "theme_version": "1.0.0",
    "theme_author": "Lunelle Studio",
    "theme_documentation_url": "https://lunelle.com/docs",
    "theme_support_url": "https://lunelle.com/support"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Lunelle Brand Palette"
      },
      {
        "type": "color",
        "id": "color_champagne_cream",
        "label": "Primary Background (Champagne Cream)",
        "default": "#EFE7DF",
        "info": "The soft opening, light, delicate, the moment before she begins."
      },
      {
        "type": "color",
        "id": "color_soft_nude_beige",
        "label": "Secondary Background & Accents (Soft Nude Beige)",
        "default": "#D8C7B8",
        "info": "The quiet in-between, warmth gathering. Primary logo color."
      },
      {
        "type": "color",
        "id": "color_dusty_rose_taupe",
        "label": "Highlight & Accent (Dusty Rose Taupe)",
        "default": "#B9968A",
        "info": "The blush of recognition, she is seen."
      },
      {
        "type": "color",
        "id": "color_warm_mocha_brown",
        "label": "Body Copy & Secondary Text (Warm Mocha Brown)",
        "default": "#8A6B5A",
        "info": "Grounded warmth, strength rooted in softness."
      },
      {
        "type": "color",
        "id": "color_cocoa_taupe",
        "label": "Headlines & Key UI (Cocoa Taupe)",
        "default": "#6B5448",
        "info": "Full confidence, the woman, fully arrived."
      },
      {
        "type": "color",
        "id": "color_white",
        "label": "Pure White",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Font Settings"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "cormorant_garamond_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "cormorant_garamond_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading Size Scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body Size Scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Brand Identity",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Primary Logo"
      },
      {
        "type": "image_picker",
        "id": "logo_mark",
        "label": "Brand Mark (Lotus Silhouette)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo Width",
        "default": 180
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Cart & Rituals",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out Drawer"
          },
          {
            "value": "page",
            "label": "Dedicated Cart Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold (in PHP)",
        "default": 3500
      },
      {
        "type": "checkbox",
        "id": "enable_gift_note",
        "label": "Enable 'Gift to Yourself' packaging note",
        "default": true,
        "info": "Lets customer write an intentional whisper note placed inside the box."
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL",
        "default": "https://instagram.com/lunelle.official"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL",
        "default": "https://facebook.com/lunelle.official"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok URL",
        "default": "https://tiktok.com/@lunelle.official"
      }
    ]
  }
]
