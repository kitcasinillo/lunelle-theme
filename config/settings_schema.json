[
  {
    "name": "theme_info",
    "theme_name": "Lunelle Luxury OS 2.0",
    "theme_author": "Lunelle Studio",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://github.com/kitcasinillo/lunelle-theme",
    "theme_support_email": "kitcasinillo@gmail.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Lunelle Brand Palette"
      },
      {
        "type": "color",
        "id": "color_champagne_cream",
        "label": "Primary Background (Champagne Cream)",
        "default": "#EFE7DF"
      },
      {
        "type": "color",
        "id": "color_soft_nude_beige",
        "label": "Secondary Background (Soft Nude Beige)",
        "default": "#D8C7B8"
      },
      {
        "type": "color",
        "id": "color_dusty_rose_taupe",
        "label": "Highlight & Accent (Dusty Rose Taupe)",
        "default": "#B9968A"
      },
      {
        "type": "color",
        "id": "color_warm_mocha_brown",
        "label": "Body Copy & Secondary Text (Warm Mocha Brown)",
        "default": "#8A6B5A"
      },
      {
        "type": "color",
        "id": "color_cocoa_taupe",
        "label": "Headlines & Key UI (Cocoa Taupe)",
        "default": "#6B5448"
      },
      {
        "type": "color",
        "id": "color_white",
        "label": "Pure White",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Brand Identity",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Primary Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo Width",
        "default": 180
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Image"
      }
    ]
  },
  {
    "name": "Cart & Rituals",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out Drawer"
          },
          {
            "value": "page",
            "label": "Dedicated Cart Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold (in PHP)",
        "default": 3500
      },
      {
        "type": "checkbox",
        "id": "enable_gift_note",
        "label": "Enable 'Whisper Note to Yourself' note",
        "default": true
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL",
        "default": "https://instagram.com/lunelle.official"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL",
        "default": "https://facebook.com/lunelle.official"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok URL",
        "default": "https://tiktok.com/@lunelle.official"
      }
    ]
  }
]
